# Trading King Academy — environment

VITE_APP_NAME=Trading King Academy
VITE_APP_URL=http://localhost:5173
VITE_COMPANY_NAME=Trading King Academy
VITE_COMPANY_URL=https://www.tradingkingacademy.com

# Supabase (Auth + Postgres). Leave empty to keep the localStorage mock.
# Each live academy (Trading King, NextGen FX, Trade Rise, TradesX, FX Nova)
# must use its own Supabase project and its own copy of these three keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — never prefix with VITE_. Used by /api/admin/users to create students.
SUPABASE_SERVICE_ROLE_KEY=
# Optional aliases for the Node API (defaults to the VITE_ values above)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# REST API (optional; not required when Supabase is set)
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000

# Live AI Engine. Server-side keys are preferred (no VITE_ prefix).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional browser-exposed copies (not required)
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini

VITE_ENABLE_LIVE_VIDEO=false
VITE_DEFAULT_LOCALE=en
