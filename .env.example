# Trading King Academy — future API configuration
# Copy this file to .env.local and fill in values when a backend is available.

VITE_APP_NAME=Trading King Academy
VITE_APP_URL=http://localhost:5173
VITE_COMPANY_NAME=Trading King Academy
VITE_COMPANY_URL=https://www.tradingkingacademy.com

# REST API (not required for the local mock)
VITE_API_BASE_URL=https://www.tradingkingacademy.com/academy/v1
VITE_API_TIMEOUT_MS=15000

# Auth endpoints (replace mock auth service)
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_REGISTER_PATH=/auth/register
VITE_AUTH_FORGOT_PASSWORD_PATH=/auth/forgot-password
VITE_AUTH_RESET_PASSWORD_PATH=/auth/reset-password
VITE_AUTH_REFRESH_PATH=/auth/refresh

# CRM / enrollment integration
VITE_CRM_BASE_URL=
VITE_CRM_API_KEY=

# Live AI Engine. Server-side keys are preferred (no VITE_ prefix).
# If unset, the local proxy uses a public OpenAI-compatible tutor for development.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional browser-exposed copies (not required)
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini

# Feature flags
VITE_ENABLE_LIVE_VIDEO=false
VITE_DEFAULT_LOCALE=en
